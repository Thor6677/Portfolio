---
import Base from '../../layouts/Base.astro';
import { getPostBySlug } from '../../lib/db';
import sanitizeHtml from 'sanitize-html';

const { slug } = Astro.params;
const post = getPostBySlug(slug!);

if (!post || post.published !== 1) {
  return new Response(null, { status: 404 });
}

const dateStr = new Date(post.created_at * 1000).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const safeHtml = sanitizeHtml(post.content_html, {
  allowedTags: ['p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'strong', 'em',
                'code', 'pre', 'blockquote', 'ul', 'ol', 'li', 'br', 'hr', 'a'],
  allowedAttributes: {
    a: ['href', 'target', 'rel'],
    code: ['class'],
    pre: ['class'],
  },
  allowedSchemes: ['http', 'https', 'mailto'],
});
---
<Base title={post.title}>
  <article>
    <h1>{post.title}</h1>
    <time class="date">{dateStr}</time>
    <div class="content" set:html={safeHtml}></div>
  </article>
</Base>

<style>
  h1 { font-family: var(--font-serif); font-size: var(--text-h1); font-weight: 500; margin: 0 0 var(--space-2); color: var(--text-primary); line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); }
  .date { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--text-xs); display: block; margin-bottom: var(--space-8); }

  .content { font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--text-secondary); max-width: var(--measure); }
  .content h2 { font-family: var(--font-serif); font-size: var(--text-h3); font-weight: 500; color: var(--text-primary); margin-top: var(--space-8); line-height: var(--leading-tight); }
  .content a { color: var(--text-secondary); text-decoration: underline; text-decoration-color: var(--border-strong); transition: color var(--dur-fast) var(--ease-soft); }
  .content a:hover { color: var(--text-primary); }
  .content code {
    background: var(--surface-1);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--clay-300);
  }
  .content pre {
    background: var(--bg-well);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    overflow-x: auto;
    box-shadow: var(--shadow-md);
  }
  .content pre code { background: none; padding: 0; color: var(--text-secondary); }
  .content blockquote {
    border-left: 3px solid var(--clay-500);
    margin: 0;
    padding: var(--space-3) var(--space-6);
    color: var(--text-muted);
    font-style: italic;
  }
</style>
