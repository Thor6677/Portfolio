---
import Base from '../../layouts/Base.astro';
import { listPosts } from '../../lib/db';

const posts = listPosts(true);
---
<Base title="Blog">
  <h1>Blog</h1>
  <p class="subtitle">Dev writeups and notes</p>

  {posts.length === 0 ? (
    <div class="empty">Posts coming soon</div>
  ) : (
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.slug}`} class="post-link">
            <span class="post-title">{post.title}</span>
            <span class="post-date">
              {new Date(post.created_at * 1000).toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric'
              })}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  h1 { font-family: var(--font-serif); font-size: var(--text-h2); font-weight: 500; margin: 0 0 var(--space-1); color: var(--text-primary); }
  .subtitle { color: var(--text-muted); font-size: var(--text-sm); font-family: var(--font-mono); margin: 0 0 var(--space-8); }

  .empty {
    background: var(--surface-1);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list li { border-bottom: 1px solid var(--border-subtle); }
  .post-list li:last-child { border-bottom: none; }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-soft);
  }

  .post-link:hover .post-title { color: var(--text-primary); }
  .post-date { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--text-xs); flex-shrink: 0; }
</style>
