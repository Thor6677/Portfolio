---
import Base from '../layouts/Base.astro';
import { listTools } from '../lib/db';

const tools = listTools(true);
---
<Base title="Tools">
  <h1>Tools</h1>
  <p class="subtitle">Things I've built and shipped</p>

  {tools.length === 0 ? (
    <div class="empty">Tools coming soon</div>
  ) : (
    <div class="tool-list">
      {tools.map(tool => {
        let tags: string[] = [];
        try { const p = JSON.parse(tool.tags); if (Array.isArray(p)) tags = p; } catch {}
        return (
          <div class="tool-card">
            <div class="tool-header">
              <h2 class="tool-name">{tool.name}</h2>
              {tool.url && (
                <a href={tool.url} target="_blank" rel="noopener" class="live-link">Live ↗</a>
              )}
            </div>
            <p class="tool-desc">{tool.description}</p>
            {tags.length > 0 && (
              <div class="tool-tags">
                {tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
        );
      })}
    </div>
  )}
</Base>

<style>
  h1 { font-family: var(--font-serif); font-size: var(--text-h2); font-weight: 500; margin: 0 0 var(--space-1); color: var(--text-primary); }
  .subtitle { color: var(--text-muted); font-size: var(--text-sm); font-family: var(--font-mono); margin: 0 0 var(--space-8); }

  .empty {
    background: var(--surface-1);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .tool-list { display: flex; flex-direction: column; gap: var(--space-4); }

  .tool-card {
    background: var(--surface-1);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md), var(--edge-top);
    padding: var(--space-6);
  }

  .tool-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .tool-name { font-family: var(--font-serif); font-weight: 500; font-size: var(--text-h3); margin: 0; color: var(--text-primary); }

  .live-link {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--clay-500);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    transition: background var(--dur-fast) var(--ease-soft);
  }

  .live-link:hover { background: var(--surface-2); }

  .tool-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-4);
  }

  .tool-tags { display: flex; gap: var(--space-1); flex-wrap: wrap; }

  .tag {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
</style>
