---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — thunderborn.dev</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=tb" />
  </head>
  <body>
    <header class="site-nav">
      <a href="/" class="wordmark">
        <span class="tb-mark">tb</span>
        <span class="tb-name">thunderborn<span class="tb-tld">.dev</span></span>
      </a>
      <nav class="nav-links">
        <a href="/#work">Work</a>
        <a href="/blog">Blog</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
        <a href="https://github.com/Thor6677" target="_blank" rel="noopener" class="nav-gh" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>&copy; 2026 thunderborn.dev</span>
        <div class="footer-links">
          <a href="https://github.com/Thor6677" target="_blank" rel="noopener">GitHub</a>
          <a href="https://vigilant.thunderborn.dev" target="_blank" rel="noopener">Vigilant ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--bg-page) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
    max-width: 100%;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }

  .tb-mark {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background: var(--surface-1);
    border: 1.5px solid var(--clay-500);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-primary);
    box-shadow: var(--edge-top);
    flex-shrink: 0;
  }

  .tb-name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .tb-tld {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--clay-500);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-soft);
  }

  .nav-links a:hover { color: var(--text-primary); }

  .nav-gh {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--edge-top);
    transition: background var(--dur-fast) var(--ease-soft),
                border-color var(--dur-fast) var(--ease-soft);
  }

  .nav-gh:hover {
    background: var(--surface-2);
    border-color: var(--border-strong);
    color: var(--text-primary) !important;
  }

  main {
    flex: 1;
    padding: var(--space-10) var(--gutter);
    max-width: calc(var(--container-max) + var(--gutter) * 2);
    margin: 0 auto;
    width: 100%;
  }

  .site-footer {
    background: var(--bg-well);
    border-top: 1px solid var(--border-subtle);
  }

  .footer-inner {
    max-width: calc(var(--container-max) + var(--gutter) * 2);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-links a {
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-soft);
  }

  .footer-links a:hover { color: var(--text-primary); }

  @media (max-width: 640px) {
    .nav-links a:not(.nav-gh) { display: none; }
  }
</style>
